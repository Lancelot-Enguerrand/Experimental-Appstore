{
  "$schema": "https://schemas.runtipi.io/app-info.json",
  "name": "Fluffy Chat",
  "available": true,
  "exposable": true,
  "dynamic_config": true,
  "port": 8133,
  "id": "fluffychat",
  "tipi_version": 3,
  "version": "latest",
  "categories": [ "social" ],
  "description": "Open source, nonprofit and cute [matrix] client written in Flutter",
  "short_desc": "Matrix Client",
  "author": "https://github.com/krille-chan",
  "source": "https://github.com/etkecc/fluffychat-web/",
  "form_fields": [
    {
      "type": "url",
      "label": "Your Matrix Server URL",
      "hint": "add a custom server to the list of available ones",
      "default": "matrix.org",
      "required": false,
      "env_variable": "FLUFFYCHAT_DEFAULT_SERVER"
    },
    {
      "type": "text",
      "label": "Application Name",
      "hint": "Title on top of the page",
      "required": false,
      "default": "FluffyChat",
      "env_variable": "FLUFFYCHAT_APPLICATION_NAME"
    },
    {
      "type": "text",
      "label": "Welcome Text",
      "hint": "Message on Login Page",
      "required": false,
      "env_variable": "FLUFFYCHAT_WELCOME_TEXT"
    }
  ],
  "supported_architectures": [
    "arm64",
    "amd64"
  ],
  "force_pull": true,
  "created_at": 1755453844444,
  "updated_at": 1793437266666,
  "min_tipi_version": "4.8.0"
}
